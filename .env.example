# Copy to .env. Secrets are 1Password references resolved by `op run --env-file=.env`.
# Django signing key for sessions and CSRF (required unless DQ_DEBUG=1).
DJANGO_SECRET_KEY=op://dev/dq-web/secret_key
# Hostnames the app answers to; https origins for these are trusted for CSRF.
DQ_ALLOWED_HOSTS=quizzes.dayonetools.com,localhost,127.0.0.1
# 1 for local development only (insecure key, non-secure cookies).
DQ_DEBUG=
# Port gunicorn binds on 127.0.0.1; deploy-site assigns it on the server.
PORT=8000
# Data directory for dq.db, web.sqlite3 (accounts, sessions) and PDFs. Default ~/.dq.
# DQ_HOME=~/.dq
# none disables photo grading and sentence writing; lmstudio uses DQ_LLM_URL / DQ_LLM_MODEL.
DQ_BACKEND=none
# DQ_LLM_URL=http://localhost:1234/v1
# DQ_LLM_MODEL=
# Time zone for timestamps in the admin.
# DQ_TIME_ZONE=America/Chicago
# Optional: checks puzzle answers that are not in the answer list (OpenRouter decisions API).
# Without it, unlisted answers are marked wrong and the grown-up can flip them.
# OPENROUTER_API_KEY="op://dev/OpenRouter API Key/credential"
# DQ_JUDGE_MODEL=typesafe/jev-1.14
